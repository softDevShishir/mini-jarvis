# Copy to .env and fill in. Never commit .env.

# --- Business (used in agent prompts; works for any industry) ---
BUSINESS_DESCRIPTION=a small trades business
BUSINESS_CURRENCY=AUD

# --- AI providers (set at least one key) ---
ANTHROPIC_API_KEY=
# Check https://docs.anthropic.com/en/docs/about-claude/models for a current model name
ANTHROPIC_MODEL=claude-sonnet-5-5

GEMINI_API_KEY=
# Check https://ai.google.dev/gemini-api/docs/models for a current model name
GEMINI_MODEL=gemini-3.5-flash-lite

OPENAI_API_KEY=
# Check https://developers.openai.com/api/docs/models for a current model name
OPENAI_MODEL=gpt-6.1-sol
# Default provider: claude, gemini or openai

AI_PROVIDER=claude
# Optional: claude, gemini or openai. Used only after the primary fails with 429/temporary errors.
AI_FALLBACK_PROVIDER=

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/minijarvis
DB_USERNAME=minijarvis
DB_PASSWORD=minijarvis
# Host port for the compose Postgres (the app itself does not use it)
POSTGRES_HOST_PORT=5433

# --- Security ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
# At least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=Kkh/+w7Tmp0XAaSdrnxuqVrd2iZWvO1m4G1/Nnmy+mrSYyc3k2kcfGMg912tCuv6

# --- Scheduling & cost control ---
SCHEDULER_ENABLED=false
SCHEDULER_CRON=0 0 7 * * MON-FRI
MAX_AGENT_RUNS_PER_DAY=20

# --- Telegram (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
